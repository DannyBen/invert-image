#!/usr/bin/env bash
set -euo pipefail

platform="${1:-linux}"
case "$platform" in
  linux) output=dist/invert-image ;;
  windows) output=dist/invert-image.exe ;;
  *) echo "unsupported platform: $platform" >&2; exit 1 ;;
esac

mkdir -p dist
version=$(go run ./tools/build-version.go)
GOOS="$platform" GOARCH=amd64 CGO_ENABLED=0 go build \
  -buildvcs=false -trimpath \
  -ldflags="-s -w -X main.Version=$version" \
  -o "$output" .
